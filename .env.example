# Newsbot configuration. Copy to .env and fill in what you need.
# The app runs fully offline without any of these (deterministic summaries, no alerts).

# --- AI summaries (optional) ---
# Without this, digests use the deterministic local summarizer.
OPENAI_API_KEY=

# --- Telegram alerts / digest push (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Reddit collector (optional; collector is skipped if unset) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=newsbot/0.1 by your-username

# --- App settings (optional; sensible defaults shown) ---
# NEWSBOT_DATABASE_URL=sqlite:///data/newsbot.db
# NEWSBOT_BASE_URL=http://127.0.0.1:8000
# NEWSBOT_TIMEZONE=Asia/Singapore
# Set to false to require OpenAI for summaries instead of the local fallback.
# NEWSBOT_OFFLINE_SUMMARIES=true

# Note: X uses the no-auth syndication endpoint over curated handles in
# config/sources.yaml — no API key needed (and X_BEARER_TOKEN is no longer used).
